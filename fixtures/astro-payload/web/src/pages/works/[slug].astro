---
import Base from '../../layouts/Base.astro'
import { getWork, imageUrl } from '../../lib/cms'
const work = await getWork(Astro.params.slug ?? '')
if (!work) return Astro.redirect('/404')
---
<Base title={`${work.title} | BMSF Reference Works`} description={work.summary}><article><p><a href="/">Back to works</a></p><h1>{work.title}</h1>{imageUrl(work.heroImage) && <img src={imageUrl(work.heroImage)} alt={typeof work.heroImage === 'string' ? '' : work.heroImage.alt} />}<p>{work.summary}</p></article></Base>
<style>article { max-width: 52rem; } img { width: 100%; height: auto; }</style>
